rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    match /pets/{uid}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
        && (request.auth.uid == uid || isAdmin())
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
    match /{allPaths=**} { allow read: if true; allow write: if false; }
  }
}
