rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Administradores: se crean a mano en la consola
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Bitácora del panel de administración
    match /adminLog/{id} {
      allow read, create: if isAdmin();
    }

    // Catálogo: lectura pública
    match /pets/{petId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if signedIn() && (resource.data.shelterId == request.auth.uid || isAdmin());
    }

    match /users/{userId} {
      allow read, write: if signedIn();
      allow delete: if isAdmin();
    }

    match /adopterProfiles/{userId} {
      allow read, write: if signedIn();
    }

    match /swipes/{swipeId} {
      allow read, create, update: if signedIn();
      allow delete: if isAdmin();
    }

    // ---------- APADRINAMIENTO ----------
    // Un apadrinamiento por padrino y animal (id = padrino_animal)
    match /sponsorships/{id} {
      allow read: if signedIn() && (resource.data.sponsorId == request.auth.uid
                                    || resource.data.shelterId == request.auth.uid
                                    || isAdmin());
      allow create: if signedIn() && request.resource.data.sponsorId == request.auth.uid
                       && request.resource.data.estado == 'pendiente';
      allow update: if signedIn() && (
        // el padrino: monto, pausar o cancelar
        (resource.data.sponsorId == request.auth.uid && changedOnly(['monto','pausado','cancelado','updatedAt']))
        // el refugio: activar o finalizar
        || (resource.data.shelterId == request.auth.uid && changedOnly(['estado','updatedAt']))
        || isAdmin());
      allow delete: if isAdmin();
    }

    // Cada aportación: la crea el padrino y la confirma el refugio (doble confirmación)
    match /sponsorPayments/{id} {
      allow read: if signedIn() && (resource.data.sponsorId == request.auth.uid
                                    || resource.data.shelterId == request.auth.uid
                                    || isAdmin());
      allow create: if signedIn() && request.resource.data.sponsorId == request.auth.uid
                       && request.resource.data.confirmadoRefugio == false;
      allow update: if signedIn() && ((resource.data.shelterId == request.auth.uid
                                        && changedOnly(['confirmadoRefugio','fechaRefugio']))
                                      || isAdmin());
      allow delete: if isAdmin();
    }

    // Línea de vida pública: recibos y novedades que sube el refugio
    match /sponsorPosts/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.shelterId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.shelterId == request.auth.uid || isAdmin());
    }
  }
}
